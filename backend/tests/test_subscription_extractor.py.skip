"""
Tests for the SubscriptionExtractor service.

Tests cover:
- AI extraction logic with mocked OpenAI responses
- Data cleaning and validation
- Trial detection
- Confidence scoring
- Edge cases and error handling
"""
import pytest
from unittest.mock import Mock, AsyncMock, patch
from decimal import Decimal
from datetime import datetime, timezone

from app.services.subscription_extractor import SubscriptionExtractor
from app.email_providers.base import EmailMessage


@pytest.fixture
def mock_openai_client():
    """Mock OpenAI client for testing."""
    mock_client = Mock()
    mock_client.chat = Mock()
    mock_client.chat.completions = Mock()
    return mock_client


@pytest.fixture
def sample_subscription_email():
    """Sample subscription email for testing."""
    return EmailMessage(
        id="test-123",
        message_id="msg-123",
        subject="Your Netflix subscription",
        sender="netflix@netflix.com",
        sender_name="Netflix",
        received_date=datetime.now(timezone.utc),
        body_text="Your Netflix subscription: $15.99 per month. Renews on December 5, 2025.",
        body_html="<html>Your Netflix subscription: $15.99 per month.</html>",
        headers={}
    )


