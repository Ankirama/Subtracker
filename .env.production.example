# ===========================================
# Subscription Tracker - Production Environment
# ===========================================
# Copy this file to .env.production and fill in your values
# NEVER commit the .env.production file to version control

# ===========================================
# Application Settings
# ===========================================
APP_NAME=Subscription Tracker
DEBUG=False
LOG_LEVEL=INFO

# ===========================================
# Domain Configuration (Traefik)
# ===========================================
# Your domain name (no subdomain needed)
DOMAIN_NAME=subscriptionstracker.io
# Full URLs for the application
FRONTEND_URL=https://subscriptionstracker.io
CORS_ORIGINS=https://subscriptionstracker.io

# ===========================================
# Database Configuration
# ===========================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
POSTGRES_USER=subscriptions
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=subscriptions
DATABASE_URL=postgresql://subscriptions:CHANGE_ME_STRONG_PASSWORD_HERE@postgres:5432/subscriptions

# ===========================================
# Redis Configuration
# ===========================================
REDIS_URL=redis://redis:6379/0

# ===========================================
# Celery Configuration
# ===========================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ===========================================
# Security Configuration
# ===========================================
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL

# ===========================================
# Registration Control
# ===========================================
# Set to True to require invite tokens for registration (recommended for production)
REQUIRE_INVITE_TOKEN=True

# ===========================================
# OpenAI Configuration
# ===========================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_ASSISTANT_ID=

# Rate Limiting for OpenAI API
OPENAI_REQUEST_DELAY_SECONDS=1.0
OPENAI_MAX_REQUESTS_PER_MINUTE=60

# ===========================================
# Email Processing Settings
# ===========================================
DEFAULT_BATCH_SIZE=100
DEFAULT_CONFIDENCE_AUTO_ACCEPT=85.0
DEFAULT_CONFIDENCE_REVIEW_MIN=50.0
DEFAULT_SYNC_PERIOD_DAYS=30

# ===========================================
# Resend Email Configuration
# ===========================================
# Get API key from: https://resend.com/api-keys
# Free tier: 3,000 emails/month, 100/day
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@subscriptionstracker.io
RESEND_FROM_NAME=Subscription Tracker

# ===========================================
# Push Notifications (VAPID Keys)
# ===========================================
# Generate VAPID keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_CLAIM_EMAIL=mailto:admin@subtracker.ankirama.com

# ===========================================
# Docker Image Tags (optional)
# ===========================================
# BACKEND_TAG=latest
# FRONTEND_TAG=latest

# Google OAuth Configuration (Gmail Integration)
# Get credentials from: https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID (Web application)
# Add http://localhost:8000/api/oauth/google/callback to Authorized redirect URIs
GOOGLE_CLIENT_ID="XXXX"
GOOGLE_CLIENT_SECRET="XXX"
GOOGLE_REDIRECT_URI=http://XXXX/api/oauth/google/callback
