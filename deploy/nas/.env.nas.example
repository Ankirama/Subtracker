# Subscription Tracker — NAS / Dockhand environment
# Paste these keys into Dockhand's stack "Environment" tab (it becomes the stack .env).
# NEVER commit the filled-in version. Generate real secrets, don't reuse the placeholders.

# ---------- Images (GHCR) ----------
# Lowercase owner/repo. Leave IMAGE_TAG=latest to always pull the newest main build.
GITHUB_REPOSITORY=ankirama/subtracker
IMAGE_TAG=latest

# ---------- Data location ----------
# Where the bind-mounted data lives (postgres/redis/backups/logos/logs go in subdirs of this).
# Default is ./data (relative to the stack dir). Set an absolute path to store it on a chosen
# volume — MUST be local storage (Postgres corrupts on SMB/NFS). Pre-create + chown it (see guide).
DATA_PATH=/volume2/docker/subtracker

# ---------- NAS user (file ownership) ----------
# Every service (except the frontend) runs as this uid:gid, so the ./data files are owned by
# your NAS user instead of root. UGREEN/Synology default: uid 1000 (your user), gid 100 (users).
# You MUST pre-create and chown the data dirs before the first deploy — see the deploy guide.
PUID=1000
PGID=100

# ---------- Database ----------
POSTGRES_DB=subscription_tracker
POSTGRES_USER=subtracker
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# ---------- Security ----------
# JWT_SECRET_KEY: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ENCRYPTION_KEY (Fernet, for mailbox credentials):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_fernet_key

# ---------- OpenAI ----------
OPENAI_API_KEY=sk-CHANGE_ME
OPENAI_ASSISTANT_ID=
OPENAI_REQUEST_DELAY_SECONDS=1.0
OPENAI_MAX_REQUESTS_PER_MINUTE=60

# ---------- URLs ----------
# CORS_ORIGINS: your public HTTPS origin(s), comma-separated, no spaces. The SPA calls /api
# same-origin so CORS is rarely exercised, but list it to be safe.
CORS_ORIGINS=https://subtracker.example.com
# FRONTEND_URL: used for OAuth redirects back to the app, invite links, and email links.
# Set it to the public HTTPS domain NPM serves.
FRONTEND_URL=https://subtracker.example.com

# ---------- Push notifications (VAPID) — REQUIRED ----------
# The backend will NOT start without these. Generate a keypair with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=CHANGE_ME_vapid_public_key
VAPID_PRIVATE_KEY=CHANGE_ME_vapid_private_key
VAPID_CLAIM_EMAIL=mailto:you@example.com

# ---------- Google OAuth (Gmail integration) ----------
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID.
# Add this EXACT redirect URI there under "Authorized redirect URIs":
#   https://subtracker.example.com/api/oauth/google/callback
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=https://subtracker.example.com/api/oauth/google/callback

# ---------- Registration ----------
# True = new users need an invite token (admins generate them). Set False for open sign-up.
REQUIRE_INVITE_TOKEN=True

# ---------- Email (Resend) — OPTIONAL ----------
# Powers invite emails and weekly summaries. Keep the test defaults below to DISABLE email
# (the app still runs; emails just aren't sent). Resend has a free tier — if you want emails,
# create an API key at resend.com and verify a sending domain, then fill these in.
RESEND_API_KEY=test_key
RESEND_FROM_EMAIL=test@example.com
RESEND_FROM_NAME=Subscription Tracker

# ---------- App ----------
DEBUG=False
LOG_LEVEL=INFO

# ---------- Automatic PostgreSQL backups ----------
# Schedule: @daily / @hourly / @weekly, or a cron expression like "0 3 * * *".
# Retention is kept per day/week/month.
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6
# Optional: Discord webhook URL for backup success/failure notifications.
# Server Settings → Integrations → Webhooks → New Webhook → Copy URL. Leave blank to disable.
DISCORD_WEBHOOK_URL=

# ---------- Email processing ----------
DEFAULT_BATCH_SIZE=100
DEFAULT_CONFIDENCE_AUTO_ACCEPT=85.0
DEFAULT_CONFIDENCE_REVIEW_MIN=50.0
DEFAULT_SYNC_PERIOD_DAYS=30
