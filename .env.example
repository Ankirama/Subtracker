# Database Configuration
DATABASE_URL=postgresql://postgres:devpassword@postgres:5432/subscription_tracker

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_ASSISTANT_ID=  # Will be created during setup

# Security Configuration
JWT_SECRET_KEY=change-this-to-a-secure-random-string-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption (for mailbox credentials)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-encryption-key-here

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Application Configuration
DEBUG=True
LOG_LEVEL=INFO

# Email Processing Configuration
DEFAULT_BATCH_SIZE=100
DEFAULT_CONFIDENCE_AUTO_ACCEPT=85.0
DEFAULT_CONFIDENCE_REVIEW_MIN=50.0
DEFAULT_SYNC_PERIOD_DAYS=30  # Default period for email sync (7, 30, 90, 180, 365)

# OpenAI Rate Limiting Configuration
# Adjust these values to respect OpenAI API rate limits and avoid errors
OPENAI_REQUEST_DELAY_SECONDS=1.0  # Delay between OpenAI API calls (0.5-2.0 recommended)
OPENAI_MAX_REQUESTS_PER_MINUTE=60  # Maximum requests per minute

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
